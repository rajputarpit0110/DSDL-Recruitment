logs/
*.log

# Runtime/temp
pids/
*.pid
tmp/
temp/

# Test coverage
coverage/
*.lcov

# Editor/OS
.vscode/
.idea/
.DS_Store

# Credentials
google-credentials.json
service-account-key.json
*.pem
*.key

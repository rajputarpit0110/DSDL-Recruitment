# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/dsdl_recruitment

# Admin Security Credentials (set in a real .env file, never commit secrets)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=change_me_in_production
JWT_SECRET=replace_with_secure_random_secret

# Domain Validation Configuration
ALLOWED_EMAIL_DOMAIN=kiet.edu

# Optional Google Sheets Integration
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

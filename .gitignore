# ============================================================
# DSDL Recruitment Website — .gitignore
# ============================================================

# ------ Dependencies ----------------------------------------
node_modules/
.npm
.pnp
.pnp.js

# ------ Environment Variables (secrets!) --------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep the example file committed (no real secrets inside)
!.env.example

# ------ Build Output ----------------------------------------
dist/
build/
out/
.vite/

# ------ MongoDB Memory Server Cache -------------------------
# Contains large platform-specific binaries (>100 MB)
backend/node_modules/.cache/mongodb-memory-server/
**/mongodb-memory-server/

# ------ Logs ------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------ Runtime / Temp --------------------------------------
pids/
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/

# ------ Test Coverage ---------------------------------------
coverage/
*.lcov
.nyc_output/

# ------ Editor / IDE ----------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# ------ OS --------------------------------------------------
.AppleDouble
.LSOverride
Icon

# ------ Google Service Account Credentials ------------------
google-credentials.json
service-account-key.json
*.pem
*.key

# ------ Misc ------------------------------------------------
*.tgz
*.zip
